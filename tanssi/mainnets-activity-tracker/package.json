{
  "name": "evm-chain-indexer",
  "version": "1.0.0",
  "description": "Indexer for EVM chains metrics tracking",
  "main": "lib/processor.js",
  "scripts": {
    "build": "tsc",
    "db:create": "squid-typeorm-migration generate",
    "db:apply": "squid-typeorm-migration apply",
    "db:revert": "squid-typeorm-migration revert",
    "process": "node --require=dotenv/config lib/processor.js",
    "serve": "npx squid-graphql-server",
    "start": "node --require=dotenv/config lib/processor.js",
    "typegen": "sqd typegen"
  },
  "dependencies": {
    "@subsquid/evm-processor": "^1.27.3",
    "@subsquid/graphql-server": "4.11.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "ethers": "^6.15.0",
    "graphql": "15.8.0",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^4.4.0",
    "@subsquid/typeorm-codegen": "^2.0.2"
  },
  "overrides": {
    "graphql": "15.8.0"
  },
  "author": "",
  "license": "MIT"
}
