# Copy environment configuration
cp .env.example .env

# Edit the .env file with your chain configuration
# For Tanssi EVM (example):
RPC_ENDPOINT=https://services.tanssi-mainnet.network/tanssi-2004
START_BLOCK=0

# Database will be managed by Docker Compose
DB_HOST=postgres
DB_PORT=5432
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres

# Aggregation settings
AGGREGATE_INTERVAL_MINUTES=1440